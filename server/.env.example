# ==============================================================================
# SmartStudent AI — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core
# ------------------------------------------------------------------------------

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-very-secret-key-change-this-in-production

# "development" or "production". Development refuses to start with a public host.
DJANGO_ENV=development

# Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Database (only required for DJANGO_ENV=production)
# ------------------------------------------------------------------------------

DB_NAME=smartstudent
DB_USER=smartstudent_user
DB_PASSWORD=change_me_in_production
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ------------------------------------------------------------------------------
# CORS (comma-separated origins, no trailing slashes)
# ------------------------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Redis / Celery
# ------------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------------------

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------------------------
# AI — Ollama
# ------------------------------------------------------------------------------

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Fail fast when the model isn't running; keep it loaded between questions.
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=180
# Hard ceiling (seconds) on writing one streamed answer.
OLLAMA_ANSWER_DEADLINE=240
OLLAMA_KEEP_ALIVE=2h

# ------------------------------------------------------------------------------
# AI — ChromaDB (vector store)
# ------------------------------------------------------------------------------

# Leave blank to use default path: server/chroma_db/
# Leave blank to use server/chroma_db
CHROMA_DB_PATH=
CHROMA_COLLECTION_PREFIX=smartstudent

# ------------------------------------------------------------------------------
# RAG Parameters
# ------------------------------------------------------------------------------

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K_RESULTS=6
# Cosine distance above which a passage is treated as unrelated to the question.
RAG_MAX_DISTANCE=0.45
# auto = Celery when Redis is reachable, otherwise index in-process; celery | sync to force.
DOCUMENT_PROCESSING_MODE=auto

# ------------------------------------------------------------------------------
# Document Uploads
# ------------------------------------------------------------------------------

MAX_DOCUMENT_SIZE_MB=50

# ------------------------------------------------------------------------------
# Email (only required for DJANGO_ENV=production)
# ------------------------------------------------------------------------------

EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@smartstudentai.com

# ------------------------------------------------------------------------------
# Production Security
# ------------------------------------------------------------------------------

# Keep True in production. Behind a TLS-terminating proxy, also set
# TRUST_X_FORWARDED_PROTO=true (only if the proxy always sets that header).
SECURE_SSL_REDIRECT=True
TRUST_X_FORWARDED_PROTO=false
# Web origin(s) for CSRF on the admin site, e.g. https://aurastudy.example.edu
CSRF_TRUSTED_ORIGINS=

# ------------------------------------------------------------------------------
# Feature switches
# ------------------------------------------------------------------------------

# OpenAPI schema / Swagger / ReDoc (on in development, off in production).
ENABLE_API_DOCS=false
# Older conversation API and generators with no UI (summaries, quizzes, viva,
# glossary, learning analytics). Off unless you have reviewed them for your use.
ENABLE_LEGACY_ASSISTANT_API=false

# ------------------------------------------------------------------------------
# Embedding model
# ------------------------------------------------------------------------------

# Changing this requires `manage.py index_documents --rebuild`; searches refuse
# collections built with a different model.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# After the model has been downloaded once, keep inference fully offline:
# HF_HUB_OFFLINE=1

# Minutes after which a document stuck in "processing" is treated as interrupted.
DOCUMENT_STALE_MINUTES=20

# Rate limits (DRF format, e.g. 40/min)
AI_THROTTLE_RATE=40/min
INDEXING_THROTTLE_RATE=30/hour

# ------------------------------------------------------------------------------
# Demo data (development only; seed_demo refuses to run in production)
# ------------------------------------------------------------------------------

# DEMO_ADMIN_PASSWORD=
# DEMO_TEACHER_PASSWORD=
# DEMO_STUDENT_PASSWORD=
