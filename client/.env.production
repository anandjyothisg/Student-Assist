# AuraStudy — Production Environment Variables (Cloudflare Pages)
#
# These variables are set in the Cloudflare Pages dashboard under
# Settings → Environment Variables, NOT in this file.
# This file documents what is required.
#
# In development, copy this to .env and set the local values:
#   VITE_API_URL=http://localhost:8000

# ─── Required ────────────────────────────────────────────────────────
# The HTTPS base URL of the deployed Django API, WITHOUT a trailing slash.
# Example: https://api.aurastudy.example.com
VITE_API_URL=
